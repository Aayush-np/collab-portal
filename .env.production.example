# ====================================
# PRODUCTION ENVIRONMENT VARIABLES
# ====================================
# Copy this to Render's environment variables during deployment
# Replace all placeholder values with your actual values

# ===== Backend Server =====
PORT=4000
NODE_ENV=production

# ===== Frontend URLs =====
# Update this with your actual Netlify URL after deployment
FRONTEND_URL=https://your-site-name.netlify.app
APP_BASE_URL=https://your-site-name.netlify.app

# ===== JWT Secrets =====
# IMPORTANT: Generate very long random strings for these!
# Go to https://randomkeygen.com/ and generate two "CodeIgniter Encryption Keys"
JWT_SECRET=your-very-long-random-secret-key-at-least-64-characters
REFRESH_TOKEN_SECRET=your-another-very-long-random-secret-key-at-least-64-characters

# ===== Token Expiration =====
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
RESET_TOKEN_EXPIRES_MINUTES=20

# ===== Allowed Email Domain =====
# Only this email domain can register/login (CMRIT portal)
ALLOWED_EMAIL_DOMAIN=cmrit.ac.in

# ===== Admin Emails =====
# Add your email to get superadmin access
SUPERADMIN_EMAILS=your-email@example.com
EDITOR_ADMIN_EMAILS=
SUPPORT_ADMIN_EMAILS=
ADMIN_EMAILS=

# ===== Database Configuration =====
# Use MongoDB (recommended for production)
DB_PROVIDER=mongo
# Your MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://collab_portal:YOUR_PASSWORD@your-cluster-name.mongodb.net/collab_portal?retryWrites=true&w=majority
MONGODB_DB_NAME=collab_portal

# ===== Email Configuration (Optional) =====
# For password reset emails - if not set, links appear in console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@collab-portal.app

# ===== Google Authentication (Optional) =====
ENABLE_GOOGLE_AUTH=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Bot / Brute-Force Protection (Optional, recommended) =====
# Cloudflare Turnstile: create a free widget at https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=

# ===== Frontend Client Variables (Vite) =====
VITE_API_BASE_URL=https://collab-portal-api.onrender.com/api
VITE_SOCKET_URL=https://collab-portal-api.onrender.com
VITE_ENABLE_GOOGLE_AUTH=0
VITE_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile public site key (pairs with TURNSTILE_SECRET_KEY above)
VITE_TURNSTILE_SITE_KEY=
